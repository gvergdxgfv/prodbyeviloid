# ============================================================
# Beat-to-Instagram Reel Automation — Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Instagram Graph API ---
# Your Instagram Business/Creator account numeric ID
IG_USER_ID=17841400000000000
# Long-lived access token (valid ~60 days, refresh before expiry)
IG_ACCESS_TOKEN=your-long-lived-access-token-here

# --- Video Settings ---
# Max number of YouTube clips to download per beat
MAX_CLIPS_PER_BEAT=5
# Default duration (seconds) for each YouTube clip segment
CLIP_SEGMENT_DURATION=10
# Maximum Reel duration in seconds (Instagram max is 900, but 30-60 is ideal)
VIDEO_DURATION_MAX=60
# Output video resolution (width x height, 9:16 vertical)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920

# --- Public Video Hosting (for IG upload) ---
# The automation starts a temporary local HTTP server to serve the video.
# If you have a public server/domain, set it here. Otherwise leave as-is.
# Format: http://your-public-ip:port  (the port is auto-assigned)
PUBLIC_VIDEO_HOST=auto
# If using ngrok for tunnelling, set your ngrok authtoken
NGROK_AUTHTOKEN=

# --- Paths (optional, defaults shown) ---
BEATS_DIR=beats
CLIPS_DIR=clips
OUTPUT_DIR=output

# --- YouTube Data API (for Shorts upload) ---
# Download OAuth2 client secrets JSON from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create project → Enable YouTube Data API v3
# 3. Create OAuth 2.0 Client ID (Desktop App)
# 4. Download JSON → save as client_secrets.json in project root
YT_CLIENT_SECRETS_FILE=client_secrets.json
YT_TOKEN_FILE=yt_token.json
